# ================================
# VINDRA CODE - CONFIGURAÇÕES
# ================================

# Token do bot (obtenha em https://discord.com/developers/applications)
DISCORD_TOKEN=SEU_TOKEN_AQUI

# IDs do Discord
GUILD_ID=SEU_SERVER_ID
CATEGORY_ID=ID_DA_CATEGORIA_DE_TICKETS  # Categoria onde os tickets serão criados

# IDs dos canais
TICKET_PANEL_CHANNEL=ID_DO_CANAL_DO_PAINEL  # Canal onde o embed de tickets será enviado
LOG_CHANNEL=ID_DO_CANAL_DE_LOGS  # Canal onde serão registradas ações de ticket

# IDs dos cargos
STAFF_ROLE_ID=ID_DO_CARGO_STAFF  # Cargo com permissão para ver/gerenciar tickets
TICKET_SUPPORTER_ROLE_ID=ID_DO_CARGO_SUPORTE  # Cargo de suporte

# IDs das mensagens (para edição futura)
TICKET_PANEL_MESSAGE_ID=ID_DA_MENSAGEM_DO_PAINEL  # Deixe vazio na primeira execução
